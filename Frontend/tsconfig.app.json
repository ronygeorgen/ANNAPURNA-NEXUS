{
    "extends": "./tsconfig.json",
    "compilerOptions": {
      "composite": true,
      "types": ["node"],
      "jsx": "react-jsx",
      "baseUrl": ".",
        "paths": {
        "@/*": [
            "./src/*"
        ]
        }
    },
    "include": [
      "src/**/*.ts",
      "src/**/*.tsx",
      "src/**/*.d.ts"
    ],
    "references": [
      {
        "path": "./tsconfig.node.json"
      }
    ]
  }